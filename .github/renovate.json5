{
  // JSON5 spec: https://json5.org/
  // Renovate docs: https://docs.renovatebot.com/configuration-options/
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":enablePreCommit",
    ":gitSignOff",
  ],
  // Only rebase open PRs when they have merge conflicts, not on every
  // merge to main. The default "behind-base-branch" (from
  // config:recommended) causes a cascade of unnecessary rebases and
  // review-agent re-runs on busy days.
  "rebaseWhen": "conflicted",
  "dependencyDashboard": true,
  // Give newly released dependencies time to receive initial security review.
  "minimumReleaseAge": "10 days",
  "lockFileMaintenance": {
    "enabled": true,
    // Lock file maintenance creates virtual entries without releaseTimestamp.
    // Inheriting the top-level minimumReleaseAge blocks these PRs indefinitely
    // under Renovate 42+'s default timestamp-required behaviour.
    "minimumReleaseAge": null,
  },
  "customManagers": [
    {
      // Track fullsend-ai/agents version pins in harness base: URLs.
      // SHA256 hashes are updated automatically by postUpgradeTasks
      // (scripts/renovate/update-fullsend-harness-sha.sh).
      "customType": "regex",
      "description": "Track fullsend-ai/agents version in harness base URLs",
      "managerFilePatterns": [".fullsend/harness/*.yaml"],
      "matchStrings": [
        "base:\\s*\"https://raw\\.githubusercontent\\.com/fullsend-ai/agents/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/",
      ],
      "depNameTemplate": "fullsend-ai/agents",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
    },
  ],
  "packageRules": [
    {
      // After fullsend-ai/agents version bump, recompute SHA256 hashes in
      // harness base: URLs.
      "description": "Update fullsend harness SHA256 hashes on version bump",
      "matchPackageNames": ["fullsend-ai/agents"],
      "postUpgradeTasks": {
        "commands": ["bash scripts/renovate/update-fullsend-harness-sha.sh"],
        "fileFilters": [".fullsend/harness/*.yaml"],
        "executionMode": "branch",
      },
    },
    {
      // Registries without release timestamps would otherwise leave Docker
      // updates pending indefinitely.
      "description": "Allow container updates without release timestamp",
      "matchDatasources": [
        "docker",
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
    },
    {
      // Red Hat registry images are trusted through the Red Hat image
      // delivery pipeline and do not need the generic stability wait.
      "description": "No stability wait for Red Hat base images",
      "matchPackageNames": [
        "registry.access.redhat.com/{/,}**",
        "registry.redhat.io/{/,}**",
      ],
      "minimumReleaseAge": null,
    },
    {
      // Pin pre-commit hook revisions to commit SHAs for supply-chain
      // integrity, consistent with docker:pinDigests and
      // helpers:pinGitHubActionDigests.
      "description": "Pin pre-commit hooks by commit SHA",
      "matchManagers": [
        "pre-commit",
      ],
      "pinDigests": true,
    },
  ],
  // Security fixes should be proposed immediately.
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days",
  },
}
